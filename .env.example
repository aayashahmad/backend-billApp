# Copy to .env for local development. Never commit the real .env.
#
# On Render both of these come from render.yaml — DATABASE_URL is injected
# from the managed database and SECRET_KEY is generated once.

DATABASE_URL=postgresql://localhost/item_gallery

# Signs the JWTs. Use a long random value; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production

# Where uploaded payment screenshots are written.
UPLOADS_DIR=uploads
